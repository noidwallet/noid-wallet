{
  "name": "noid-wallet-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API for the NOID mobile wallet: locked-down proxy to a Parano1d node plus a history indexer.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "price-check": "tsx scripts/price-check.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@noble/hashes": "1.8.0",
    "better-sqlite3": "12.4.1",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.8",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
