[Unit]
Description=Parano1d node (backend for the NOID mobile wallet)
After=network-online.target
Wants=network-online.target

[Service]
User=noid
Group=noid
# Official Core release, verified against SHA256SUMS. RPC stays on loopback:
# the node gives owner rights to any local caller, so never expose 9601.
ExecStart=/opt/parano1d/parano1d --data-dir /var/lib/parano1d --p2p-listen 0.0.0.0:9600 --rpc-listen 127.0.0.1:9601 --log info
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
# The node keeps its config file in ~/.parano1d (created at install; "-" = don't
# refuse to start if it is missing).
ReadWritePaths=/var/lib/parano1d -/home/noid/.parano1d
PrivateTmp=true

[Install]
WantedBy=multi-user.target
