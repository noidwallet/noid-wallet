[Unit]
Description=NOID mobile wallet API (proxy + history indexer)
After=parano1d.service
Requires=parano1d.service

[Service]
# Its own user: it cannot read the node's files (node wallet, keys).
User=noidapi
Group=noidapi
WorkingDirectory=/opt/noid-wallet-backend
Environment=NODE_ENV=production
Environment=NOID_RPC_URL=http://127.0.0.1:9601
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DB_PATH=/var/lib/noid-wallet/wallet-index.sqlite
Environment=TRUST_PROXY=1
# Notifications are switched on by a drop-in (deploy/noid-wallet-api-push.conf,
# see SETUP-NOTIFICATIONS.md), so copying this file again never turns them off.
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/noid-wallet
# Even if the API were compromised: no node data, backups or other keys.
InaccessiblePaths=-/var/lib/parano1d -/var/backups/noid -/home/noid
ProtectProc=invisible
ProcSubset=pid
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
