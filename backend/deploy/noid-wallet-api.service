[Unit]
Description=NOID mobile wallet API (proxy + history indexer)
After=parano1d.service
Requires=parano1d.service

[Service]
# Its own user: it cannot read the node's files (node wallet, keys).
User=noidapi
Group=noidapi
WorkingDirectory=/opt/noid-wallet-backend
Environment=NODE_ENV=production
Environment=NOID_RPC_URL=http://127.0.0.1:9601
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=DB_PATH=/var/lib/noid-wallet/wallet-index.sqlite
Environment=TRUST_PROXY=1
# Notifications (see SETUP-NOTIFICATIONS.md): systemd hands the key file to
# this service only, at $CREDENTIALS_DIRECTORY/firebase.json.
#LoadCredential=firebase.json:/etc/noid/firebase-service-account.json
#Environment=FCM_SERVICE_ACCOUNT=%d/firebase.json
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/noid-wallet
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
