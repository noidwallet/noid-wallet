# HTTP/1.1 and HTTP/2 only. HTTP/3 runs over UDP, which some mobile and home
# networks throttle or drop mid-transfer: large downloads (the APK) stalled in
# browsers while plain TCP downloads finished in seconds.
{
	servers {
		protocols h1 h2
	}
	# Error and redirect logs would otherwise record client IPs next to the
	# address a phone asked about (e.g. /v1/address/o1.../utxos) in the journal.
	log default {
		output stderr
		exclude http.log.access http.log.error http.handlers.reverse_proxy
	}
}

# HTTPS for the wallet API and the link pages. Point both DNS A records
# (api.<domain> and <domain>) at the server; Caddy gets certificates itself.
api.noidusa.com {
	encode gzip
	reverse_proxy 127.0.0.1:8787
	log {
		output discard
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Gift and payment link pages. The gift secret is after "#" in those links,
# which browsers never send here; no logs, no third-party scripts, no referrer.
noidusa.com, www.noidusa.com {
	root * /var/www/noid-site
	encode gzip
	try_files {path} {path}/index.html
	file_server
	log {
		output discard
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# The Android app download: saved as a file, never cached stale.
	@apk path /download/*.apk
	header @apk Content-Type "application/vnd.android.package-archive"
	header @apk Content-Disposition "attachment"
	header @apk Cache-Control "no-cache"
	@wellknown path /.well-known/assetlinks.json
	header @wellknown Content-Type "application/json"
}
