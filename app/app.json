{
  "expo": {
    "name": "Noidly",
    "slug": "noidly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "noidly",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060B0A",
    "android": {
      "package": "com.dpeluola.noidly",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#060B0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.USE_BIOMETRIC"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": true }],
      "expo-font",
      ["expo-camera", { "barcodeScannerEnabled": true, "recordAudioAndroid": false }],
      ["expo-local-authentication", { "faceIDPermission": "Unlock Noidly." }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "defaultApiUrl": "https://api.yourdomain.com"
    }
  }
}
